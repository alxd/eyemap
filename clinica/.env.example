# Copy to .env.local for local development, or set in the Vercel project.

# Neon / Vercel Postgres connection string
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Auth.js
AUTH_SECRET=generate-with-openssl-rand-base64-32
# Optional: set in production to your clinic domain
AUTH_URL=https://clinica.eyemap.ai

# MinIO — public endpoint (Tailscale Funnel hostname, no scheme)
MINIO_PUBLIC_ENDPOINT=your-machine.your-tailnet.ts.net
MINIO_PUBLIC_PORT=443
MINIO_PUBLIC_USE_SSL=true

# MinIO — internal endpoint used when signing URLs for the local GPU worker
MINIO_INTERNAL_ENDPOINT=127.0.0.1
MINIO_INTERNAL_PORT=9000
MINIO_INTERNAL_USE_SSL=false

MINIO_ACCESS_KEY=eyemap
MINIO_SECRET_KEY=change-me-minio-secret
MINIO_BUCKET=fundus

# Shared secret between Vercel API and the Python GPU worker
WORKER_SHARED_SECRET=change-me-worker-secret

# Seed script only
SEED_PASSWORD=changeme123
