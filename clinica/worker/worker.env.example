# Copy to worker.env (do not commit secrets)
CLINICA_API_BASE=https://clinica.eyemap.ai
WORKER_SHARED_SECRET=change-me-worker-secret

OLLAMA_HOST=http://127.0.0.1:11434
# MG backend (not shown in the dashboard)
OLLAMA_MODEL=medgemma-1.5-4b-vision:latest
POLL_INTERVAL_SEC=3
MAX_IDLE_BACKOFF_SEC=30
NUM_PREDICT=512
OLLAMA_TIMEOUT=600

COMPARE_LLMS_DIR=/media/alex/9c367132-3c4d-42d6-9642-bc832fff61ab/compare_llms

# MedSigLIP weights (compare_llms / dato_ssd)
MEDSIGLIP_WEIGHTS=/media/alex/dato_ssd/ollama_models/MedSigLIP.safetensors

# EyeMap DR / AMD weights root — must contain retinopathy/ and amd/
# (old Windows path in compare_llms/config.py is invalid on this machine)
# EYEMAP_MODELS_DIR=/path/to/eyemap_models

# EyeMap Top
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_BASE_URL=https://api.openai.com/v1
# Do not set OPENAI_TEMPERATURE for gpt-5.x (only default=1 is allowed).
# OPENAI_MAX_COMPLETION_TOKENS=2400
